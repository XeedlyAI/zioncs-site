# ─────────────────────────────────────────────────────────────────────────
# ZionCS environment template. Copy to .env.local and fill in.
# .env.local is git-ignored and must NEVER be committed.
# ─────────────────────────────────────────────────────────────────────────

# Anthropic — Intelligence Console (Wave 6)
ANTHROPIC_API_KEY=

# Resend — quote/intake/contact email (Wave 6/7/13)
RESEND_API_KEY=

# Cron auth — shared secret Vercel Cron sends as `Authorization: Bearer …`
CRON_SECRET=

# ─────────────────────────────────────────────────────────────────────────
# Track B — Meta social sync (DARK until all of the below are set).
# Leaving SOCIAL_SYNC_ENABLED unset/false keeps the hand-curated static feed.
# ─────────────────────────────────────────────────────────────────────────

# Master switch. Set to "true" only once Meta + Supabase are fully wired.
SOCIAL_SYNC_ENABLED=false

# Meta Graph API
META_GRAPH_VERSION=v21.0
# Long-lived Page access token (~60-day TTL; refresh monthly).
META_GRAPH_TOKEN=
# Instagram Business/Creator user id (must be linked to the FB Page).
META_IG_USER_ID=
# Facebook Page id. ZionCS = 61573114690934
META_FB_PAGE_ID=61573114690934
# Max posts pulled per platform per sync.
SOCIAL_SYNC_LIMIT=25

# Supabase (feed cache storage)
SUPABASE_URL=
# Service-role key — server-only. Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=
SOCIAL_TABLE=social_posts
